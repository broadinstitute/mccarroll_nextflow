docker.enabled = true

params {
    seqeraWorkspace  = null                                                     // 'org/workspace'
    computeEnv       = null                                                     // compute-env display name
    helloPipeline    = 'https://github.com/broadinstitute/mccarroll_nextflow'
    helloMainScript  = 'workflows/launch_downstream/hello_greeting/main.nf'
    helloSchema      = 'workflows/launch_downstream/hello_greeting/nextflow_schema.json'
    helloRevision    = 'ks_launch_downstream'                                   // branch holding hello_greeting
    towerApiEndpoint = 'https://api.cloud.seqera.io'
}

plugins {
    id 'nf-schema@2.7.1'
}

// projectDir is the repo root on Seqera Platform (remote git launch) but the
// workflow subdir when run locally / under nf-test. Pick whichever schema
// actually exists for the current context.
validation {
    parametersSchema = new File("${projectDir}/workflows/launch_downstream/hello_launcher/nextflow_schema.json").exists()
        ? "${projectDir}/workflows/launch_downstream/hello_launcher/nextflow_schema.json"
        : "${projectDir}/nextflow_schema.json"
}
