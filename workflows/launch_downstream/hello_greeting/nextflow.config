docker.enabled = true

params {
    greeting = 'Hello'
}

plugins {
    id 'nf-schema@2.7.1'
}

// projectDir is the repo root on Seqera Platform (remote git launch) but the
// workflow subdir when run locally / under nf-test. Pick whichever schema
// actually exists for the current context.
validation {
    parametersSchema = new File("${projectDir}/workflows/launch_downstream/hello_greeting/nextflow_schema.json").exists()
        ? "${projectDir}/workflows/launch_downstream/hello_greeting/nextflow_schema.json"
        : "${projectDir}/nextflow_schema.json"
}
