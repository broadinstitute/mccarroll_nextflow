params {
    from    = null
    to      = null
    subject = null
    text    = null
}

mail {
    smtp {
        host              = 'smtp.sendgrid.net'
        port              = 587
        user              = 'apikey'
        password          = secrets.SENDGRID_API_KEY
        auth              = true
        starttls.enable   = true
        starttls.required = true
        ssl.protocols     = 'TLSv1.2 TLSv1.3'
        // Timeouts (in milliseconds)
        connectiontimeout = 5000
        timeout           = 5000
        writetimeout      = 5000
    }
}
