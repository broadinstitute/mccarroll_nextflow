plugins {
    // NOTE: must include all the plugins due to these issues
    // - A second plugin config overrides not appends to to the first plugin {} config
    //   - https://github.com/nextflow-io/nextflow/issues/7724
    // - If a workflow that hasn't migrated to nf-schema 3 has its plugin versions unpinned, it ends up crashing
    //   - https://github.com/nextflow-io/nf-schema/issues/239
    // Be sure to also update the root nextflow.config with the same nf-schema version
    id 'nf-schema@3.1.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
    id 'nf-google' // Google Cloud integration for Nextflow
}

includeConfig 'google/cellbender.config'
